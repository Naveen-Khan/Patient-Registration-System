{
  "builds": [
    {
      "src": "requirements.txt",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/dashboard",
      "dest": "/backend.py"
    },
    {
      "src": "/vapi-webhook",
      "dest": "/backend.py"
    },
    {
      "src": "/(.*)",
      "dest": "/backend.py"
    }
  ],
  "framework": "fastapi"
}
