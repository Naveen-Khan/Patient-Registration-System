{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/app.py" },
    { "src": "/dashboard", "dest": "/app.py" },
    { "src": "/patients", "dest": "/app.py" },
    { "src": "/patients/check-phone", "dest": "/app.py" },
    { "src": "/vapi-webhook", "dest": "/app.py" },
    { "src": "/(.*)", "dest": "/app.py" }
  ],
  "framework": "fastapi"
}